# Generated into CODEX_HOME/config.toml by setup.sh.
# The Telegram-action MCP server lives in telegram-ai-core and runs in that
# repository's virtualenv; both paths are substituted at install time.

[mcp_servers.telegram_actions]
command = "__MCP_PYTHON__"
args = ["__CORE_DIR__/telegram_actions_mcp.py"]
startup_timeout_sec = 20.0
# delegate_to_bridge can wait several minutes for the other agent's answer.
tool_timeout_sec = 700.0
default_tools_approval_mode = "auto"
