[Unit]
Description=Codex Jarvis userbot backend
Documentation=https://github.com/maleon17/codex-ask
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=/home/__USER__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional: owner name/id for the persona template, and chats where the
# persona's profanity is suppressed. Written by setup.sh; '-' = ok if absent.
EnvironmentFile=-__INSTALL_DIR__/jarvis.env
# JARVIS_RELAY_TOKEN (one instance) or JARVIS_RELAY_TOKENS_JSON (many
# instances) in this root-owned EnvironmentFile authenticates the local
# telegram_actions_mcp.py client to the shared relay.
Environment=CODEX_HOME=__CODEX_HOME__
Environment=CODEX_JARVIS_CODEX_HOME=__CODEX_HOME__
Environment=CODEX_JARVIS_CWD=__CODEX_CWD__
ExecStart=/usr/bin/python3 -u __INSTALL_DIR__/codex_ask_watcher.py
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
