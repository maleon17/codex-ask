[Unit]
Description=Codex Jarvis userbot backend
Documentation=https://github.com/maleon17/codex-ask
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=__HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional: owner name/id for the persona template, and chats where the
# persona's profanity is suppressed. Written by setup.sh; '-' = ok if absent.
EnvironmentFile=-__INSTALL_DIR__/jarvis.env
# JARVIS_RELAY_TOKENS_JSON (instance_id -> token) authenticates this worker's
# Telegram MCP client to the shared relay. Written by setup.sh,
# mode 0600; this worker has its own file so another product's setup never
# overwrites it.
EnvironmentFile=-__CONFIG_DIR__/relay-token-codex.env
# The component registry and relay credentials (shared with telegram-ai-core).
Environment=TELEGRAM_AI_CONFIG_DIR=__CONFIG_DIR__
Environment=CODEX_HOME=__CODEX_HOME__
Environment=CODEX_JARVIS_CODEX_HOME=__CODEX_HOME__
Environment=CODEX_JARVIS_CWD=__CODEX_CWD__
# Must match the relay's JARVIS_STATE_DIR: the queues are shared files.
Environment=JARVIS_STATE_DIR=__STATE_DIR__
ExecStart=/usr/bin/python3 -u __INSTALL_DIR__/codex_ask_watcher.py
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
